{
  "compilerOptions": {
    "target": "ES2023",
    "module": "commonjs",
    "moduleResolution": "node",
    "esModuleInterop": true,
    "strict": true,
    "baseUrl": ".",

    "experimentalDecorators": true,
    "emitDecoratorMetadata": true,

    "types": ["node", "jest"],

    "typeRoots": [
      "4. backend/node_modules/@types"
    ],

    "paths": {
      "@nestjs/*": [
        "4. backend/node_modules/@nestjs/*"
      ],
      "supertest": [
        "4. backend/node_modules/supertest"
      ]
    }
  },

  "include": [
    "0. tests/backend/**/*.ts",
    "0. tests/end-to-end/**/*.ts",
    "4. backend/src/**/*.ts"
  ]
}
